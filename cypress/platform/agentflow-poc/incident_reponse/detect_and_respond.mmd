agentflow TB
  type Incident = Record {
    id: String
    severity: String
    title: String
    services: List<String>
    region: String
    start_time: String
    status: String
  }

  type Finding = Record {
    category: String
    evidence: String
    confidence: String
    recommendation: String
  }

  type HealthCheck = Record {
    service: String
    status: String
    latency_p99_ms: Int
    error_rate_pct: Float
    region: String
  }

  type Severity = P0 | P1 | P2 | P3 | P4
  type IncidentStatus = Detected | Triaged | Investigating | Mitigating | Resolved | PostMortem

  agent incident_team["Incident Team"]
    flow detect_and_respond["Detect & Respond"]
      agent sentinel["Sentinel"]
        task detect["Detect Anomaly"]
          region["region"]
          poll_health["poll_health"]
          health_data["Health Data"]
          detect_anomaly["detect_anomaly"]
          alert["Alert"]
          region --> poll_health --> health_data --> detect_anomaly --> alert
        end
      end

      agent monitor["Monitor"]
        task triage["Triage"]
          triage_alert["triage_alert"]
          triage_result["Triage Result"]
          alert --> triage_alert --> triage_result
          triage_alert --o triage_tpl_ref
        end
      end

      agent investigator["Investigator"]
        task investigate["Investigate"]
          analyze_incident["analyze_incident"]
          investigation["Investigation Report"]
          triage_result --> analyze_incident --> investigation
          analyze_incident --o investigation_tpl_ref
        end
        task rca["Root Cause Analysis"]
          root_cause_analysis["root_cause_analysis"]
          root_cause["Root Cause"]
          investigation --> root_cause_analysis --> root_cause
        end
        investigate --> rca
      end

      agent responder["Responder"]
        task mitigate["Generate Runbook"]
          generate_runbook["generate_runbook"]
          runbook["Runbook"]
          root_cause --> generate_runbook --> runbook
          generate_runbook --o runbook_tpl_ref
        end
      end

      agent reporter["Reporter"]
        task report["Create Dashboard"]
          create_report["create_report"]
          dashboard["Incident Dashboard"]
          runbook --> create_report --> dashboard
          triage_result --> create_report
          investigation --> create_report
          root_cause --> create_report
          create_report --- dashboard_style
        end
      end
    end
  end

  triage_tpl_ref["%triage_result"]
  investigation_tpl_ref["%investigation_report"]
  runbook_tpl_ref["%runbook_format"]
  permit_ref["Permission Tree"]

  region@{ shape: lean-right }
  health_data@{ shape: doc }
  alert@{ shape: doc }
  triage_result@{ shape: doc }
  investigation@{ shape: doc }
  root_cause@{ shape: doc }
  runbook@{ shape: doc }
  dashboard@{ shape: doc }
  dashboard_style@{ shape: lin-doc }
  triage_tpl_ref@{ shape: procs, type: "triage_result" }
  investigation_tpl_ref@{ shape: procs, type: "investigation_report" }
  runbook_tpl_ref@{ shape: procs, type: "runbook_format" }
  permit_ref@{ shape: procs, src: "./permit-tree.mmd" }

  poll_health@{ shape: subroutine, returns: "String", requires: "^llm.query", description: "Poll service health endpoints for a given region" }
  detect_anomaly@{ shape: subroutine, returns: "String", requires: "^llm.query", description: "Analyze health data for anomalies against baselines" }
  triage_alert@{ shape: subroutine, returns: "String", requires: "^llm.query", output: "%triage_result", description: "Assess severity, blast radius, and form initial hypothesis" }
  analyze_incident@{ shape: subroutine, returns: "String", requires: "^llm.query", output: "%investigation_report", description: "Deep-dive into metrics, dependencies, and failure cascades" }
  root_cause_analysis@{ shape: subroutine, returns: "String", requires: "^llm.query", description: "Determine root cause with causal chain and confidence assessment" }
  generate_runbook@{ shape: subroutine, returns: "String", requires: "^llm.query", output: "%runbook_format", description: "Generate step-by-step mitigation with rollback procedures" }
  create_report@{ shape: subroutine, returns: "String", requires: "^llm.query", description: "Build dark-mode incident dashboard as single-file HTML" }

  sentinel@{ model: "claude-sonnet-4-20250514", permits: "^llm.query" }
  monitor@{ model: "claude-sonnet-4-20250514", permits: "^llm.query" }
  investigator@{ model: "claude-sonnet-4-20250514", permits: "^llm.query" }
  responder@{ model: "claude-sonnet-4-20250514", permits: "^llm.query" }
  reporter@{ model: "claude-sonnet-4-20250514", permits: "^llm.query" }

  detect_and_respond@{ params: "region :: String", returns: "String" }
