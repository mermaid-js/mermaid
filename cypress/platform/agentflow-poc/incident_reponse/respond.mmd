agentflow LR






flow respond
      direction TB
      task Step1
        direction TB
         aMonitor{{monitor}}@{ agent: monitor } --- anomalyDetector@{ tool: detect_anomaly }
        aMonitor --o triage@{ shape:doc }
      end

      task Step2
        direction TB
        anInvestigator{{investigator}}@{agent: investigator } --- analyze_incident@{ shape: subroutine }
        anInvestigator --o investigation@{ shape:doc }
      end

      task Step3
        direction TB
        investigator2{{investigator}}@{agent: investigator } --- root_cause_analysis@{ shape: subroutine }
        investigator2 --o triage_alert@{ shape:doc }
      end

      task Step4
        direction TB
        aResponder{{responder}}@{ agent: responder } --- generate_runbook@{ shape: subroutine }
        aResponder --o runbook@{ shape:doc }
      end

      task Step5
        direction TB
        aReporter{{reporter}}@{ agent: reporter } --- create_report@{ shape: subroutine }
        aReporter --o aDashboard@{ shape:doc }
      end
    end
    Step1 -->|"triage"| Step2
    Step2 -->|"investigation"| Step3
    Step3 -->|"root_cause"| Step4

    %% Fan-in for Step5

    Step4 -->|"triage"| Step5
    Step4 -->|"investigation"| Step5
    Step4 -->|"root_cause"| Step5
    Step4 -->|"runbook"| Step5

    task PStep1["Pipeline step 1"]
        s1["sentinel"]@{ shape: hex, agent: sentinel } --- poll_health@{ shape: subroutine }
        s1 --o health_data@{ shape: doc}
    end

    task PStep2["Pipeline step 2"]
      s2["sentinel"]@{ shape: hex, agent: sentinel } --- detect_anomaly@{ shape: subroutine }
      s2 --o alert@{ shape: doc}
    end

    task PStep3["Pipeline step 3"]
      respond["flow respond"]@{ shape: procs, src: "./respond.mmd"}
      respond --o dashboard@{ shape: doc}
    end
    PStep1 --> PStep2 --> PStep3
    respond@{

      view: expanded
    }
