agentflow TB
  type Incident = Record {
    id: String
    severity: String
    title: String
    services: List<String>
    region: String
    start_time: String
    status: String
  }

  type Finding = Record {
    category: String
    evidence: String
    confidence: String
    recommendation: String
  }

  type HealthCheck = Record {
    service: String
    status: String
    latency_p99_ms: Int
    error_rate_pct: Float
    region: String
  }

  type Severity = P0 | P1 | P2 | P3 | P4
  type IncidentStatus = Detected | Triaged | Investigating | Mitigating | Resolved | PostMortem
