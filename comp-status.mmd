agentflow TB
  # ===== External integration points (connectors) =====
  connector github["GitHub API"]
  github@{ protocol: "http", endpoint: "https://api.github.com", auth: "bearer", token_required: true }

  connector slack["Slack"]
  slack@{ protocol: "mcp", transport: "stdio", command: "slack mcp server", description: "status channel C0AHRPT37Q9" }

  connector mermaid_chart["Mermaid Chart"]
  mermaid_chart@{ protocol: "mcp", transport: "stdio", command: "local mermaid MCP (mcp.json)", description: "daily-kanban project e3e7dfe2-57f8-4e30-85c0-d59dc183a3ed" }

  # ===== Compound skill, modelled as an orchestrating agent =====
  agent comp_status["comp-status — Status Dashboard"]

    # ---- Input ----
    time_window["time_window"]@{ shape: lean-right, type: String, value: "14d" }

    # ---- Setup: arg parsing + atomic-load-config ----
    parse_args["Parse time window"]@{ reads: ["time_window"], writes: ["days_back"] }
    load_config["atomic-load-config"]@{
      shape: subroutine, requires: ["fs.read"], returns: "Config",
      writes: ["github_repo", "triage_label", "state_path", "bot_prefix", "tone"]
    }

    # ---- Fetch ----
    fetch_status["Fetch Data"]@{
      shape: subroutine, connectorRef: "github", requires: ["net.read"],
      params: { repo: String, triage_label: String, days_back: Int },
      returns: "StatusJSON",
      reads: ["github_repo", "triage_label", "days_back"],
      writes: ["status_data", "warnings", "counts", "pr_summary"]
    }
    fetch_script["fetch-status.sh"]@{ shape: procs, src: ".claude/skills/comp-status/scripts/fetch-status.sh" }

    # ---- Data-integrity branch ----
    warnings_check{Data warnings?}
    note_warnings["Include warnings in report"]@{ reads: ["warnings"], writes: ["report_warnings"] }

    # ---- Inline analysis pipeline (tasks) ----
    analyze["Analyze Activity"]@{
      description: "Threads, new issues/PRs, duplicates, bot PRs, dependencies",
      reads: ["status_data", "counts", "pr_summary", "bot_prefix"], writes: ["analysis"]
    }
    compare_trends["Compare Trends"]@{
      description: "Deltas vs. previous saved report",
      reads: ["analysis", "state_path"], writes: ["trends"]
    }
    generate_report["Generate Report"]@{
      description: "Markdown dashboard (sections 1-10)",
      reads: ["analysis", "trends", "report_warnings", "tone"], writes: ["report"]
    }

    # ---- Persist + broadcast (atomic skills + MCP tools) ----
    save_report["atomic-save-report"]@{
      shape: subroutine, requires: ["fs.write"],
      reads: ["report", "state_path"], writes: ["report_path"]
    }
    slack_post["atomic-slack-post"]@{
      shape: subroutine, connectorRef: "slack", requires: ["net.write"],
      reads: ["report"], writes: ["slack_ts"]
    }

    # ---- Kanban (sub-skill + publish + link back) ----
    gen_kanban["needs-response-kanban"]@{
      shape: subroutine, reads: ["report"], writes: ["kanban_code"]
    }
    publish_kanban["create_mermaid_chart_diagram"]@{
      shape: subroutine, connectorRef: "mermaid_chart", requires: ["net.write"],
      reads: ["kanban_code"], writes: ["edit_url"]
    }
    post_link["slack_reply_to_thread"]@{
      shape: subroutine, connectorRef: "slack", requires: ["net.write"],
      reads: ["slack_ts", "edit_url"]
    }

    # ---- Reference documents (read, not produced) ----
    kanban_spec["needs-response-kanban / SKILL.md"]@{ shape: lin-doc }
    slack_guide["atomic-slack-post threading"]@{ shape: lin-doc }
    voice_guide["comp-slack-post — Pratchett voice"]@{ shape: lin-doc }

    # ----- Sequencing (data travels via shared state, not these edges) -----
    time_window --> parse_args --> load_config --> fetch_status --> warnings_check
    warnings_check -- yes --> note_warnings --> analyze
    warnings_check -- no --> analyze
    analyze --> compare_trends --> generate_report --> save_report --> slack_post
    slack_post --> gen_kanban --> publish_kanban --> post_link

    # ----- Reference attachments (--- association, no labels) -----
    fetch_status --- fetch_script
    gen_kanban --- kanban_spec
    slack_post --- slack_guide
    slack_post --- voice_guide
  end
  comp_status@{
    model: "claude-opus-4-6",
    prompt: "Surface new activity that needs attention — unanswered comments, fresh issues, PRs awaiting review, duplicate PRs, bot PRs, and triage backlog.",
    permits: ["net.read", "net.write", "fs.read", "fs.write", "llm.query"],
    params: { time_window: String },
    returns: "StatusDashboard"
  }
