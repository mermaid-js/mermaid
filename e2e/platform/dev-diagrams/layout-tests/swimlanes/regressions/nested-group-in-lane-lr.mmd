%% A subgraph nested in a lane: the group has to be framed around its nodes
%% and sit inside the lane that holds it.
swimlane-beta LR
  subgraph L1[Sales]
    subgraph G1[Intake]
      A[Receive order] --> B[Check stock]
    end
    C[Confirm]
  end
  subgraph L2[Warehouse]
    D[Pick] --> E[Ship]
  end
  B --> C --> D
