%% A lane with no nodes, between two populated lanes: in TB it needs a column of its own
%% between them, with the lanes after it moved right.
swimlane-beta TB
  subgraph L1[Sales]
    A[Receive order] --> B[Check stock]
  end
  subgraph L2[Legal]
  end
  subgraph L3[Warehouse]
    C[Pick] --> D[Ship]
  end
  B --> C
