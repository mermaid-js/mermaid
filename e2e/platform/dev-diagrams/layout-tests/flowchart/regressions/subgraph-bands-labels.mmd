---
config:
  layout: elk
  elk:
    directedSubgraphs: aligned
---
%% The columns of a band spread over its full width, with gaps wide enough for the two-line labels of the links between them.
flowchart TB
    subgraph lead ["Planning"]
        direction LR
        P1["Plan"] --> P2["Estimate"] --> P3["Review"]
        P4["Archive"]
    end
    subgraph band [" "]
        direction LR
        subgraph colA ["Team A"]
            direction TB
            A1["Design"] --> A2["Build"] --> A3["Test"] --> A4["Release"]
        end
        subgraph colC ["Team C"]
            direction TB
            C1["Prepare"] --> C2["Check"] --> C3["Simulate"] --> C4["Report"]
        end
        subgraph colB ["Team B"]
            direction TB
            B1["Layout"] --> B2["Render"] --> B3["Review"] --> B4["Publish"]
        end
    end
    subgraph ops ["Operations"]
        direction LR
        O1["Intake"] --> O2["Wire"] --> O3["Evaluate"]
    end
    P3 --> A1
    P3 --> B1
    P1 --> C1
    P2 -.->|"protocol + stubs"| A1
    P2 -.->|"protocol + stubs"| B1
    P3 -.->|"property tests<br/>validate models"| A2
    P3 -.->|"property tests<br/>validate models"| B2
    C3 -.->|"simulator runs<br/>registered models"| A2
    C3 -.->|"simulator runs<br/>registered models"| B2
    P4 --> O1
