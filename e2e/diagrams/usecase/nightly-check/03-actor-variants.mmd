---
description: >-
  Every actor rendering variant side by side — normal, hollow, awesome
  (silhouette), icon (registered fa:user), and an icon fallback for an
  unregistered icon name — each connected to the same use case.
---
usecase-beta
    direction LR
    actor Normal("Normal actor")
    actor Hollow("Hollow actor")@{ type: hollow }
    actor Awesome("Awesome actor")@{ type: awesome }
    actor Icon("Icon actor")@{ icon: "fa:user" }
    actor Fallback("Missing icon fallback")@{ icon: "not-registered:user" }
    Manage("Manage catalog")
    Normal --> Manage
    Hollow --> Manage
    Awesome --> Manage
    Icon --> Manage
    Fallback --> Manage
