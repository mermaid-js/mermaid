flowchart TB
  start([Start]) --> check{Valid?}
  check -->|yes| a[Parse]
  check -->|no| err[Report]
  start --> log[Log]
  a --> b[Transform]
  a --> c[Index]
  b --> done((Done))
  c --> done
  log --> done
  err --> done
