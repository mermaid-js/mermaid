---
description:
  Verifies that classDef classes can be applied simultaneously to a subgraph
  container and one of its child nodes, that a node can belong to two classes at
  once (base color plus subgraph background override), and that linkStyle can
  recolor specific edges (including a thick ==> edge) by index.
config:
  htmlLabels: true
  flowchart:
    htmlLabels: true
  securityLevel: loose
---
flowchart TD
  A[Christmas] ==> D
  A[Christmas] -->|Get money| B(Go shopping)
  A[Christmas] ==> C
  subgraph T ["Test"]
  A
  B
  C
  end

  classDef Test fill:#F84E68,stroke:#333,color:white;
  class A,T Test
  classDef TestSub fill:green;
  class T TestSub
  linkStyle 0,1 color:orange, stroke: orange;
