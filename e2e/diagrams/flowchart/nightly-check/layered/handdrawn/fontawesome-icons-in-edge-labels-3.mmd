---
description:
  Checks rendering of multiple subgraphs with several interconnecting edges,
  including edges that cross between subgraphs, plus custom fill and stroke
  styling on each subgraph, under the hand-drawn look.
config:
  layout: layered
  look: handDrawn
  htmlLabels: true
  flowchart:
    htmlLabels: true
  securityLevel: loose
copyOf: flowchart/nightly-check/handdrawn/fontawesome-icons-in-edge-labels-3.mmd
---
graph TB
  A
  B
  subgraph foo[Foo SubGraph]
  C
  D
  end
  subgraph bar[Bar SubGraph]
  E
  F
  end
  G

  A-->B
  B-->C
  C-->D
  B-->D
  D-->E
  E-->A
  E-->F
  F-->D
  F-->G
  B-->G
  G-->D

  style foo fill:#F99,stroke-width:2px,stroke:#F0F,color:darkred
  style bar fill:#999,stroke-width:10px,stroke:#0F0,color:blue
