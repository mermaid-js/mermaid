---
description:
  Verifies that a classDef named default is automatically applied to every node
  without an explicit class assignment, while nodes with explicit classes keep
  their own styling, with HTML labels disabled, under the hand-drawn look.
config:
  look: handDrawn
  flowchart:
    htmlLabels: false
  fontFamily: courier
---
graph TD
  A[myClass1] --> B[default] & C[default]
  B[default] & C[default] --> D[myClass2]
  classDef default stroke-width:2px,fill:none,stroke:silver
  classDef node color:red
  classDef myClass1 color:#0000ff
  classDef myClass2 stroke:#0000ff,fill:#ccccff
  class A myClass1
  class D myClass2
