---
description:
  Verifies that CSS classes can set background and text color on both individual
  nodes and subgraphs, including a subgraph left without an explicit title,
  under the hand-drawn look.
config:
  look: handDrawn
  flowchart:
    htmlLabels: false
  fontFamily: courier
---
graph LR
  subgraph id1 [title is set]
  A-->B
  end
  subgraph id2 [title]
  E
  end

  B-->C

  subgraph id3
  C-->D
  end
  class id3,id2,A redBg;
  class id3,A whiteTxt;
  classDef redBg fill:#622;
  classDef whiteTxt color: white;
