---
description: >-
  Three chained flow containers (researcher, reviewer, reporter) where the
  middle one (reviewer) is collapsed via `view: "collapsed"`; checks that
  both its incoming and outgoing edges are redirected to terminate at the
  collapsed container node instead of being dropped or left dangling.
---
%% Edges crossing a collapsed container's boundary must terminate at the
%% collapsed node rather than being dropped.
agentflow-beta TB
  flow researcher["Research Agent"]
    patterns["Pattern Research"]@{ shape: refdoc }
  end

  flow reviewer["Review Agent"]
    validate["validate_patterns"]@{ shape: tool }
    reviewed["Reviewed Patterns"]
    patterns --> validate --> reviewed
  end

  flow reporter["Report Agent"]
    compile["compile_report"]@{ shape: tool }
    reviewed --> compile
  end

  reviewer@{ view: "collapsed" }
