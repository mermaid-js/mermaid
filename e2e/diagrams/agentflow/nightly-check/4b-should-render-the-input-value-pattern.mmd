---
description: >-
  Exercises an `input`-shaped node carrying both a `description` and a
  default `value` attribute, wired via a `flow` container into a `tool`
  node with typed `params`/`returns` metadata.
---
agentflow-beta TB
  file_path["file_path"]
  file_path@{ shape: input, description: "Path to the file in the GitHub repository to visualize", value: "src/HelloWorld.java" }

  read_file["read_file"]
  read_file@{ shape: tool, params: "path :: String", returns: "String" }

  flow runner["Runner"]
    file_path --> read_file
  end
