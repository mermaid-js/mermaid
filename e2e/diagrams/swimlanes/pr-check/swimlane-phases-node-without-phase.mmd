---
description: >-
  A node that names no phase lands in a trailing band without a title.
config:
  logLevel: 0
  flowchart:
    htmlLabels: false
    useMaxWidth: false
---
swimlane-beta LR
  phase intake["Intake"]
  phase review["Review"]
  phase closeout["Closeout"]

  subgraph customer [Customer]
    ask["Submit request"]@{ phase: intake }
    accept["Accept result"]@{ phase: closeout }
  end

  subgraph support [Support]
    triage["Triage"]@{ phase: intake }
    assess["Assess"]@{ phase: review }
    reply["Send reply"]@{ phase: closeout }
  end

  ask --> triage --> assess --> reply --> accept

  subgraph legal [Legal]
    audit["Audit trail"]
  end
  reply --> audit
