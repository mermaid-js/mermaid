%%
%% Agentflow Visual Legend v0.4.0
%%

agentflow TB

  %% ═══════════════════════════════════════
  %% CONTAINER DEFINITIONS
  %% ═══════════════════════════════════════

  agent sample_agent["Agent: Autonomous Actor"]
    task sample_task["Task: Unit of Work"]
      task_input["Input parameter"]
      task_tool["Callable tool"]
      task_output["Data artifact"]
      task_input --> task_tool --> task_output
      task_tool --o type_ref["TaskResult"]
    end
  end

  flow sample_flow["Flow: Composable Sequence"]
    flow_a["Step A"]
    flow_b["Step B"]
    flow_a --> flow_b
  end

  skill sample_skill["Skill: Composed Capability"]
    skill_search["search"]
    skill_rank["rank"]
    skill_search --> skill_rank
  end

  directive sample_directive["Directive: Behavioral Constraint"]
    dir_rule1["No PII in output"]
    dir_rule2["Rate limit"]
  end

  testCase sample_test["TestCase: Verification"]
    test_step["Run assessment"]
    test_assert["Assertion checkpoint"]
    test_step --> test_assert
  end

  %% ═══════════════════════════════════════
  %% NODE SHAPES
  %% ═══════════════════════════════════════

  subgraph node_shapes["Node Shapes"]
    direction LR
    ns_default["roundedRect: Default node"]
    ns_subroutine["subroutine: Tool"]
    ns_doc["doc: Data artifact"]
    ns_input["lean-right: Input"]
    ns_lindoc["lin-doc: Reference doc"]
    ns_procs["procs: External ref"]
    ns_stadium["stadium: Terminal"]
    ns_hex["hexagon: Permission category"]
    ns_circle["circle: Join point"]
    ns_diamond{diamond: Decision}
    ns_trapezoid["trapezoid: Constraint"]
    ns_inv_trap["inv-trapezoid: Inverted constraint"]
    ns_dblcirc["double-circle: Assertion"]
  end

  %% ═══════════════════════════════════════
  %% INSTANCE SHAPES
  %% ═══════════════════════════════════════

  subgraph instance_shapes["Instance Shapes"]
    direction LR
    is_agent["tag-rect: Agent instance"]
    is_flow["delay: Flow instance"]
    is_skill["lin-rect: Skill instance"]
    is_tool["win-pane: Tool instance"]
    is_directive["curv-trap: Directive instance"]
  end

  %% ═══════════════════════════════════════
  %% EDGE TYPES
  %% ═══════════════════════════════════════

  subgraph edge_types["Edge Types"]
    direction LR
    e1a["Source"] --> e1b["Target"]
    e2a["Producer"] --o e2b["Type"]
    e3a["Primary"] --x e3b["Fallback"]
    e4a["Parent"] -->> e4b["Child"]
    e5a["Peer A"] --- e5b["Peer B"]
    e6a["Step 1"] ==> e6b["Step 2"]
    e7a["Tool"] -.-> e7b["Constraint"]
  end

  %% ═══════════════════════════════════════
  %% TYPE AND TEMPLATE DECLARATIONS
  %% ═══════════════════════════════════════

  type TaskResult = Record {
    status: String
    output: String
    confidence: Float
  }

  type Severity = String

  template %incident_report {
    section HEADER
    INCIDENT_ID: String        <<generated incident ID>>
    SEVERITY: String           <<P0 through P4>>
    section DETAILS
    TITLE: String              <<concise incident title>>
    BLAST_RADIUS: String       <<affected services>>
    TIMELINE: String * 3       <<Timestamp | Event | Source>>
  }

  %% ═══════════════════════════════════════
  %% SHAPE ASSIGNMENTS
  %% ═══════════════════════════════════════

  %% Container metadata
  sample_agent@{ model: "claude-sonnet-4-20250514", permits: "net.read, llm.query" }
  sample_flow@{ params: "input :: String", returns: "String" }
  sample_skill@{ strategy: "parallel", params: "query :: String", returns: "Results" }
  sample_directive@{ params: "max_requests :: Int" }
  sample_test@{ assert: "result != null", expects: "non-null output" }

  %% Task child shapes
  task_input@{ shape: lean-right }
  task_tool@{ shape: subroutine, returns: "TaskResult", requires: "llm.query" }
  task_output@{ shape: doc }
  type_ref@{ shape: procs, type: "TaskResult" }

  %% Skill child shapes
  skill_search@{ shape: subroutine }
  skill_rank@{ shape: subroutine }

  %% Directive child shapes
  dir_rule1@{ shape: trapezoid, severity: "critical", rule: "Strip all PII before returning" }
  dir_rule2@{ shape: trapezoid }

  %% TestCase child shapes
  test_assert@{ shape: double-circle }

  %% Node shapes legend
  ns_subroutine@{ shape: subroutine }
  ns_doc@{ shape: doc }
  ns_input@{ shape: lean-right }
  ns_lindoc@{ shape: lin-doc }
  ns_procs@{ shape: procs }
  ns_stadium@{ shape: stadium }
  ns_hex@{ shape: hex }
  ns_circle@{ shape: circle }
  ns_trapezoid@{ shape: trapezoid }
  ns_inv_trap@{ shape: inv-trapezoid }
  ns_dblcirc@{ shape: double-circle }

  %% Instance shapes
  is_agent@{ shape: tag-rect, def: "sample_agent" }
  is_flow@{ shape: delay, def: "sample_flow" }
  is_skill@{ shape: lin-rect, def: "sample_skill" }
  is_tool@{ shape: win-pane, def: "task_tool" }
  is_directive@{ shape: curv-trap, def: "sample_directive" }

  %% Edge type node shapes
  e1a@{ shape: lean-right }
  e2b@{ shape: procs }
  e3b@{ shape: stadium }
  e4b@{ shape: stadium }
  e7b@{ shape: trapezoid }
