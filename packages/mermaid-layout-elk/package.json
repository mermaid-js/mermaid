{
  "name": "@mermaid-js/layout-elk",
  "version": "1.0.2",
  "description": "ELK layout engine for mermaid",
  "module": "dist/mermaid-layout-elk.core.mjs",
  "types": "./dist/plugin.d.ts",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "mermaid-source": "./src/plugin.ts",
      "types": "./dist/plugin.d.ts",
      "import": "./dist/mermaid-layout-elk.core.mjs",
      "default": "./dist/mermaid-layout-elk.core.mjs"
    },
    "./*": "./*"
  },
  "keywords": [
    "diagram",
    "markdown",
    "elk",
    "mermaid"
  ],
  "scripts": {
    "clean": "rimraf dist"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/mermaid-js/mermaid"
  },
  "publishConfig": {
    "access": "public"
  },
  "contributors": [
    "Knut Sveidqvist",
    "Sidharth Vinod"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  },
  "devDependencies": {
    "@types/d3": "^7.4.3"
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "@mermaid-js/core": "workspace:^",
    "d3": "^7.9.0",
    "elkjs": "^0.12.0"
  }
}
