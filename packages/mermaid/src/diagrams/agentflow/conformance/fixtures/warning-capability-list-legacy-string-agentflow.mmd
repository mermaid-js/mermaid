%% §12.1 — list-valued metadata keys must be YAML arrays; the legacy
%% comma-separated string form emits a deprecation warning.
agentflow TB
  agent researcher["R"]
    caller["c"]
    t["t"]
    t@{ shape: subroutine, requires: ["net.read"] }
    caller --> t
  end
  researcher@{ permits: "net.read, llm.query" }
