%% §19.10 Agent Delegation Pattern — delegation edge (`-->>`) between agents.
agentflow TB
  flow pipeline["Pipeline"]
    agent a1["First"]
      task t1["Step 1"]
        x1["x1"]
      end
    end
    agent a2["Second"]
      task t2["Step 2"]
        x2["x2"]
      end
    end
    a1 -->> a2
  end
