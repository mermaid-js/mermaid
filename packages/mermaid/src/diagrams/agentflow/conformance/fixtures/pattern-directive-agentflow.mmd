%% §19.5 Directive Pattern — a governance edge (`-.->`) from a tool to a
%% directive container, plus a trapezoid directive node. Asserts the edge
%% semantic is `governance` and that no validation warnings fire.
agentflow TB
  search_tool["Search"]
  search_tool@{ shape: subroutine }
  no_pii["No PII in output"]
  search_tool -.-> no_pii

  no_pii@{ shape: trapezoid, severity: "critical", rule: "Strip all PII before returning results" }

  directive safety["Safety Constraints"]
    rate_limit["Rate Limit"]
  end
  search_tool -.-> safety
