%% §19.1 Tool Call Pattern — a `shape: subroutine` tool invoked from a
%% task inside an agent. Asserts that the DB surfaces the derived
%% vertexKind: 'tool' on do_work. The enclosing agent grants the
%% required capability so the §12 executing-agent rule is satisfied.
agentflow TB
  type OutputType

  do_work["do_work"]
  do_work@{ shape: subroutine, returns: "OutputType", requires: ["llm.query"] }

  agent runner["Runner"]
    task step["Do Work"]
      input["input"]
      output["Output"]
      input ==> do_work ==> output
      do_work --o type_ref
    end
  end
  runner@{ permits: ["llm.query"] }

  input@{ shape: lean-right }
  output@{ shape: doc }
  type_ref@{ shape: procs, typeRef: "OutputType" }
