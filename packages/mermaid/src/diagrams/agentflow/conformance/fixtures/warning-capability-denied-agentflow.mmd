%% §12 — tool's requires and deny sets share a capability, violating
%% the `requires ∩ deny = ∅` rule.
agentflow TB
  agent researcher["R"]
    caller["c"]
    t["t"]
    t@{ shape: subroutine, requires: ["net.write"], deny: ["net.write"] }
    caller --> t
  end
  researcher@{ permits: ["net.write"] }
