%% Instance of a tool definition — win-pane → subroutine. Asserts the
%% resolved metadata merge per §11.3: inst inherits `returns` and
%% `requires` from search_def; local `returns` override wins.
%% The enclosing agent grants the required capability so the §12
%% executing-agent rule is satisfied.
agentflow TB
  search_def["search"]
  search_def@{ shape: subroutine, returns: "Result", requires: ["net.read"] }

  agent researcher["Researcher"]
    inst["cached search"]
    inst@{ shape: win-pane, def: "search_def", returns: "CachedResult" }
  end
  researcher@{ permits: ["net.read"] }
