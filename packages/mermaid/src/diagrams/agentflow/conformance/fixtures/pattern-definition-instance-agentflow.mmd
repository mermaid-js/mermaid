%% §19.11 Definition / Instance Pattern — `tag-rect` instances inherit from the
%% `researcher` agent definition via `def`. Adapted for the wave-1 grammar: the
%% inner tool is declared via `shape: subroutine` since the `tool` keyword lands
%% in wave 2.
agentflow TB
  agent researcher["Researcher"]
    task research["Research Task"]
      search["search"]
      search@{ shape: subroutine, returns: "String", requires: ["net.read"] }
    end
  end
  researcher@{ model: "claude-sonnet-4-20250514", permits: ["net.read", "llm.query"] }

  flow pipeline["Pipeline"]
    r1["Researcher"]
    r2["Researcher"]
    r1 --> r2
  end
  r1@{ shape: tag-rect, def: "researcher" }
  r2@{ shape: tag-rect, def: "researcher" }
