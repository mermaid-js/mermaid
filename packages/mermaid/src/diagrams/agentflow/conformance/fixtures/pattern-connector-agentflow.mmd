%% §19.8 Connector Pattern — tools bind to connector-designated nodes via
%% `connectorRef` metadata. Asserts that neither CONNECTOR_REF_UNRESOLVED
%% nor CONNECTOR_REF_NOT_A_CONNECTOR fires on valid bindings, and that the
%% tool nodes carry vertexKind: 'tool' in the semantic model.
agentflow TB
  subgraph connectors["Connectors"]
    github_mcp["GitHub MCP"]
  end
  github_mcp@{ protocol: "mcp", transport: "stdio", command: "npx -y @modelcontextprotocol/server-github" }

  create_issue["Create Issue"]
  create_issue@{ shape: subroutine, connectorRef: "github_mcp", returns: "Issue", requires: ["net.write"] }

  close_issue["Close Issue"]
  close_issue@{ shape: subroutine, connectorRef: "github_mcp", requires: ["net.write"] }
