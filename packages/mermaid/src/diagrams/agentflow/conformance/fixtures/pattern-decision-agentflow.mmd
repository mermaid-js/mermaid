%% §19.4 Decision / Alternate Flow — `diamond` is the canonical branching vertex.
agentflow TB
  task evaluate["Evaluate Result"]
    result["result"]
    check{Approved?}
    approved["Publish"]
    rejected["Revise"]
    result --> check
    check -- yes --> approved
    check -- no --> rejected
  end

  result@{ shape: lean-right }
  approved@{ shape: doc }
  rejected@{ shape: doc }
