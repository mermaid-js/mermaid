%% §19.3 Capability Taxonomy Pattern — classification uses `---`
%% (association), not delegation. Hex categories are classification
%% sources (§4.2); terminal leaves are granular permissions.
agentflow TB
  all --- data
  all --- llm
  data --- data_read
  data --- data_write

  all@{ shape: hex }
  data@{ shape: hex }
  llm@{ shape: hex }
  data_read@{ shape: terminal }
  data_write@{ shape: terminal }
