%% Integrated wave-3 coverage — one diagram that exercises every
%% validator without tripping any of them. Asserts that a well-formed
%% agentflow document sees zero warnings with all wave-3 passes active.
%%
%% - Type and template declarations (§6, §7); `typeRef` resolves.
%% - `procs` reference node with exactly one ref kind (typeRef).
%% - Agent containers with valid permits; tool invocation's `requires`
%%   is a subset of permits and disjoint from `deny`.
%% - `win-pane` instance inside the executing agent still resolves under
%%   §12 via the wave-2 inheritance chain.
%% - Flow container with declared `params` and `returns`; incoming and
%%   outgoing data edges satisfy §5.5 boundary contracts.
%% - Containment legal at every level (agent > directive > node).
%% - Delegation (`-->>`) agent-to-agent; conformance (`--o`) targets a
%%   procs reference node.
agentflow TB
  type Result

  template %triage {
    TITLE: String <<the triage title>>
  }

  search["search"]
  search@{ shape: subroutine, returns: "Result", requires: ["net.read"] }

  agent researcher["Researcher"]
    caller["c"]
    caller --> search
    instance["cached search"]
    instance@{ shape: win-pane, def: "search" }
    directive safety["Safety"]
      rule_node["rule"]
    end
  end
  researcher@{ permits: ["net.read"] }

  agent fallback_agent["Fallback"]
    fb_step["f"]
  end
  fallback_agent@{ permits: ["net.read"] }
  researcher -->> fallback_agent

  search --o ref_out
  ref_out["Result"]
  ref_out@{ shape: procs, typeRef: "Result" }

  flow pipeline["Pipeline"]
    pipe_step["s"]
  end
  pipeline@{ params: ["q"], returns: "Result" }

  input["q"]
  input ==>|q| pipeline

  downstream["done"]
  pipeline ==> downstream
