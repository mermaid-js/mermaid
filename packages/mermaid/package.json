{
  "name": "mermaid",
  "version": "12.3.0",
  "description": "Markdown-ish syntax for generating flowcharts, mindmaps, sequence diagrams, class diagrams, gantt charts, git graphs and more.",
  "type": "module",
  "module": "./dist/mermaid.core.mjs",
  "types": "./dist/mermaid.d.ts",
  "exports": {
    ".": {
      "types": "./dist/mermaid.d.ts",
      "import": "./dist/mermaid.core.mjs",
      "default": "./dist/mermaid.core.mjs"
    },
    "./*": "./*"
  },
  "keywords": [
    "diagram",
    "markdown",
    "flowchart",
    "sequence diagram",
    "gantt",
    "class diagram",
    "git graph",
    "mindmap",
    "packet diagram",
    "c4 diagram",
    "er diagram",
    "pie chart",
    "pie diagram",
    "quadrant chart",
    "requirement diagram",
    "graph",
    "eventmodeling diagram"
  ],
  "scripts": {
    "clean": "rimraf dist",
    "dev": "pnpm -w dev",
    "docs:code": "typedoc --tsconfig ../core/tsconfig.json ../core/src/defaultConfig.ts ../core/src/config.ts ../core/src/mermaid.ts && prettier --write ./src/docs/config/setup",
    "docs:build": "pnpm docs:code && pnpm docs:spellcheck && rimraf ../../docs && tsx scripts/docs.cli.mts",
    "docs:verify": "pnpm docs:code && pnpm docs:spellcheck && tsx scripts/docs.cli.mts --verify",
    "docs:pre:vitepress": "pnpm --filter ./src/docs prefetch && rimraf src/vitepress && pnpm docs:code && tsx scripts/docs.cli.mts --vitepress && pnpm --filter ./src/vitepress install --no-frozen-lockfile --ignore-scripts",
    "docs:build:vitepress": "pnpm docs:pre:vitepress && (cd src/vitepress && pnpm run build) && cpy --flat src/docs/landing/ ./src/vitepress/.vitepress/dist/landing",
    "docs:dev": "pnpm docs:pre:vitepress && concurrently \"pnpm --filter ./src/vitepress dev\" \"tsx scripts/docs.cli.mts --watch --vitepress\"",
    "docs:dev:docker": "pnpm docs:pre:vitepress && concurrently \"pnpm --filter ./src/vitepress dev:docker\" \"tsx scripts/docs.cli.mts --watch --vitepress\"",
    "docs:serve": "pnpm docs:build:vitepress && vitepress serve src/vitepress",
    "docs:spellcheck": "cspell \"src/docs/**/*.md\"",
    "docs:release-version": "tsx scripts/update-release-version.mts",
    "docs:verify-version": "tsx scripts/update-release-version.mts --verify",
    "prepublishOnly": "pnpm docs:verify-version"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/mermaid-js/mermaid"
  },
  "author": "Knut Sveidqvist",
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  },
  "standard": {
    "ignore": [
      "**/parser/*.js",
      "dist/**/*.js",
      "e2e/**/*.js"
    ],
    "globals": [
      "page"
    ]
  },
  "dependencies": {
    "@mermaid-js/core": "workspace:^",
    "@mermaid-js/diagram-cynefin": "workspace:^",
    "@mermaid-js/diagram-er": "workspace:^",
    "@mermaid-js/diagram-eventmodeling": "workspace:^",
    "@mermaid-js/diagram-info": "workspace:^",
    "@mermaid-js/diagram-ishikawa": "workspace:^",
    "@mermaid-js/diagram-journey": "workspace:^",
    "@mermaid-js/diagram-kanban": "workspace:^",
    "@mermaid-js/diagram-mindmap": "workspace:^",
    "@mermaid-js/diagram-packet": "workspace:^",
    "@mermaid-js/diagram-pie": "workspace:^",
    "@mermaid-js/diagram-quadrant": "workspace:^",
    "@mermaid-js/diagram-radar": "workspace:^",
    "@mermaid-js/diagram-requirement": "workspace:^",
    "@mermaid-js/diagram-sankey": "workspace:^",
    "@mermaid-js/diagram-treemap": "workspace:^",
    "@mermaid-js/diagram-treeview": "workspace:^",
    "@mermaid-js/diagram-venn": "workspace:^",
    "@mermaid-js/layout-cose-bilkent": "workspace:^",
    "@mermaid-js/layout-elk": "workspace:^",
    "@mermaid-js/plugin-katex": "workspace:^"
  },
  "devDependencies": {
    "@adobe/jsonschema2md": "^8.0.11",
    "@types/jsdom": "^21.1.7",
    "@types/micromatch": "^4.0.10",
    "@types/stylis": "^4.2.7",
    "chokidar": "3.6.0",
    "concurrently": "^9.2.4",
    "csstree-validator": "^4.0.1",
    "globby": "^14.1.0",
    "jison": "^0.4.18",
    "js-base64": "^3.7.8",
    "jsdom": "^26.1.0",
    "micromatch": "^4.0.8",
    "path-browserify": "^1.0.1",
    "prettier": "^3.6.2",
    "remark": "^15.0.1",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "rimraf": "^6.0.1",
    "start-server-and-test": "^2.1.5",
    "stylis": "^4.3.6",
    "typedoc": "^0.28.20",
    "typedoc-plugin-markdown": "^4.8.1",
    "typescript": "~5.7.3",
    "unist-util-flatmap": "^1.0.0",
    "unist-util-visit": "^5.0.0",
    "vitepress": "^1.6.4",
    "vitepress-plugin-search": "1.0.4-alpha.22"
  },
  "files": [
    "dist/",
    "README.md",
    "THIRD_PARTY_NOTICES"
  ],
  "publishConfig": {
    "access": "public"
  }
}
