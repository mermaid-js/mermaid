{
  "name": "@mermaid-js/layout-cose-bilkent",
  "version": "0.0.0",
  "description": "cose-bilkent layout engine for mermaid",
  "module": "dist/mermaid-layout-cose-bilkent.core.mjs",
  "types": "./dist/plugin.d.ts",
