{
  "name": "@mermaid-js/core",
  "version": "12.3.0",
  "description": "Core rendering engine shared by mermaid and its diagram, layout and plugin packages.",
  "type": "module",
  "module": "./dist/mermaid.mjs",
  "types": "./dist/mermaid.d.ts",
  "exports": {
    ".": {
      "mermaid-source": "./src/mermaid.ts",
      "types": "./dist/mermaid.d.ts",
      "import": "./dist/mermaid.mjs",
      "default": "./dist/mermaid.mjs"
    },
    "./*.js": {
      "mermaid-source": "./src/*.js",
      "types": "./dist/*.d.ts",
      "import": "./dist/*.mjs",
      "default": "./dist/*.mjs"
    }
  },
  "scripts": {
    "clean": "rimraf dist",
    "types:build-config": "tsx scripts/create-types-from-json-schema.mts",
    "types:verify-config": "tsx scripts/create-types-from-json-schema.mts --verify",
    "bench:layered": "tsx scripts/layered-bench.ts",
    "checkCircle": "npx madge --circular ./src"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/mermaid-js/mermaid",
    "directory": "packages/core"
  },
  "author": "Knut Sveidqvist",
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@braintree/sanitize-url": "^7.1.2",
    "@iconify/utils": "^3.0.2",
    "@mermaid-js/parser": "workspace:^",
    "@types/d3": "^7.4.3",
    "chevrotain": "~13.2.0",
    "cytoscape": "^3.34.0",
    "cytoscape-fcose": "^2.2.0",
    "d3": "^7.9.0",
    "dagre-d3-es": "7.0.14",
    "dayjs": "^1.11.21",
    "dompurify": "^3.4.17",
    "es-toolkit": "^1.45.1",
    "khroma": "^2.1.0",
    "marked": "^16.3.0",
    "roughjs": "^4.6.6",
    "stylis": "^4.3.6",
    "ts-dedent": "^2.2.0"
  },
  "devDependencies": {
    "@iconify/types": "^2.0.0",
    "@types/cytoscape": "^3.21.9",
    "@types/cytoscape-fcose": "^2.2.5",
    "@types/d3-scale": "^4.0.9",
    "@types/d3-scale-chromatic": "^3.1.0",
    "@types/d3-selection": "^3.0.11",
    "@types/d3-shape": "^3.1.8",
    "@types/jsdom": "^21.1.7",
    "@types/stylis": "^4.2.7",
    "ajv": "^8.17.1",
    "canvas": "^3.2.3",
    "fastdom": "1.0.12",
    "jsdom": "^26.1.0",
    "json-schema-to-typescript": "^15.0.4",
    "prettier": "^3.6.2",
    "type-fest": "^4.41.0",
    "typescript": "~5.7.3"
  },
  "files": [
    "dist/",
    "README.md",
    "THIRD_PARTY_NOTICES"
  ],
  "publishConfig": {
    "access": "public"
  }
}
