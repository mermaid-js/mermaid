{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:base",
    ":rebaseStalePrs",
    "schedule:earlyMondays",
    "security:minimumReleaseAgeNpm",
    ":automergeMinor",
    ":automergeTesters",
    ":automergeLinters",
    ":automergeTypes",
    ":automergePatch"
  ],
  "packageRules": [
    {
      "description": "minimumReleaseAge is normally not supported for digest/other update types",
      "matchManagers": ["github-actions", "dockerfile", "devcontainer", "docker-compose"],
      "matchUpdateTypes": ["major", "minor", "patch"],
      "minimumReleaseAge": "3 days"
    },
    {
      "matchUpdateTypes": ["minor", "patch", "digest"],
      "automerge": true
    },
    {
      "groupName": "all major dependencies",
      "groupSlug": "all-major",
      "matchPackagePatterns": ["*"],
      "matchUpdateTypes": ["major"]
    },
    {
      "groupName": "all minor dependencies",
      "groupSlug": "all-minor",
      "matchPackagePatterns": ["*"],
      "matchUpdateTypes": ["minor"]
    },
    {
      "groupName": "all patch dependencies",
      "groupSlug": "all-patch",
      "matchPackagePatterns": ["*"],
      "matchUpdateTypes": ["patch"]
    },
    {
      "groupName": "eslint",
      "matchPackagePatterns": ["eslint"]
    },
    {
      "groupName": "dompurify",
      "matchPackagePatterns": ["dompurify"]
    },
    {
      "matchPackageNames": ["chokidar"],
      "enabled": false
    },
    {
      "description": "langium >=4.2.2 depends on chevrotain v12, which requires Node >=22 (uses Object.groupBy). Pinned to 4.2.1 / chevrotain v11 to keep Node 20 support — bump manually and in sync when Node 20 support is dropped.",
      "matchPackageNames": ["langium", "langium-cli", "chevrotain", "@chevrotain/types"],
      "enabled": false
    }
  ],
  "dependencyDashboard": false,
  "dependencyDashboardAutoclose": true,
  "rangeStrategy": "bump"
}
